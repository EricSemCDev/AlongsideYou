--- !u!114 &247509810
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 247509808}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 52929f3675be39e4699be13a7f0d1d3c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue: {fileID: 348127731}
  defaultSpeaker: Finn
  defaultPortrait: {fileID: -361126420, guid: f4593b230d81b1247a52ab853286ddac, type: 3}
  steps:
  - text: Oi! Eu sou o <color=#FFB84D>Finn</color>, seu amigo nessa jornada. Vou
      te mostrar como as coisas funcionam por aqui.
    gamepadText: 
    speaker: 
    portrait: {fileID: 0}
    focusTarget: {fileID: 1405058051}
    focusOffset: {x: 0, y: 0}
    zoomSize: 4
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
  - text: "Esse \xE9 o <color=#6FE3E3>Al</color>. Ele se assusta f\xE1cil e fica
      mais ansioso com o tempo, ent\xE3o vamos ajud\xE1-lo a chegar longe!"
    gamepadText: 
    speaker: 
    portrait: {fileID: 0}
    focusTarget: {fileID: 640165881}
    focusOffset: {x: 0, y: 0}
    zoomSize: 4
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
  - text: "Nosso objetivo \xE9 chegar naquela <color=#FFE14A>Fagulha de Luz</color>,
      l\xE1 do outro lado."
    gamepadText: 
    speaker: 
    portrait: {fileID: 0}
    focusTarget: {fileID: 1751740473}
    focusOffset: {x: 0, y: 0}
    zoomSize: 4.5
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
  - text: "Mas uma barreira de espinhos fecha o caminho. Ela s\xF3 abre se a gente
      resolver a conta certa."
    gamepadText: 
    speaker: 
    portrait: {fileID: 0}
    focusTarget: {fileID: 1377504378}
    focusOffset: {x: 0, y: 0}
    zoomSize: 4.5
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
  - text: "Esse n\xFAmero na tocha \xE9 o <color=#FF9AFF>resultado esperado</color>.
      \xC9 ele que a nossa conta precisa dar."
    gamepadText: 
    speaker: 
    portrait: {fileID: 0}
    focusTarget: {fileID: 6728364}
    focusOffset: {x: 0, y: 0}
    zoomSize: 4
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
  - text: "Esse \xE9 um <color=#6FA8FF>espa\xE7o num\xE9rico</color>. \xC9 onde os
      blocos com n\xFAmero se encaixam."
    gamepadText: 
    speaker: 
    portrait: {fileID: 0}
    focusTarget: {fileID: 1708264224}
    focusOffset: {x: 0, y: 0}
    zoomSize: 4
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
  - text: "E aqui fica o espa\xE7o do <color=#B06CFF>operador</color>: ele decide
      se a conta soma, subtrai, multiplica ou divide."
    gamepadText: 
    speaker: 
    portrait: {fileID: 0}
    focusTarget: {fileID: 426756439}
    focusOffset: {x: 0, y: 0}
    zoomSize: 4
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
  - text: "Eu cuido das fa\xEDscas de operador. Perto de uma tocha, segure {interact}
      para abrir a roda, aponte para o operador e solte para acender. "
    gamepadText: 
    speaker: 
    portrait: {fileID: 0}
    focusTarget: {fileID: 1110261425}
    focusOffset: {x: 0, y: 0}
    zoomSize: 4
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
  - text: "O Al carrega os blocos: chegue perto e aperte {interact} para pegar, e
      de novo para encaixar num espa\xE7o."
    gamepadText: 
    speaker: 
    portrait: {fileID: 0}
    focusTarget: {fileID: 1603933981}
    focusOffset: {x: 0, y: 0}
    zoomSize: 4
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
  - text: "O Al anda com {move}. Eu sigo o mouse: segure {finn_follow} e eu vou at\xE9
      l\xE1!"
    gamepadText: "O Al anda com {move}. Caso queira me controlar, clique {swap} poder\xE1
      me controlar!"
    speaker: 
    portrait: {fileID: 0}
    focusTarget: {fileID: 0}
    focusOffset: {x: 0, y: 0}
    zoomSize: 0
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
  - text: "Agora \xE9 com a gente: encaixe o bloco, escolha o operador e abra caminho
      at\xE9 a Fagulha!"
    gamepadText: 
    speaker: 
    portrait: {fileID: 0}
    focusTarget: {fileID: 0}
    focusOffset: {x: 0, y: 0}
    zoomSize: 0
    onStepStart:
      m_PersistentCalls:
        m_Calls: []
  playOnStart: 1
  startDelay: 0.6
  playOnlyOnce: 0
  sequenceId: 
  cameraMoveSeconds: 0.7
  textStartsAtMove: 0.55
  zoomMultiplier: 0.75
  inputLockAfterLine: 0.25
  canSkip: 1
  skipHoldSeconds: 0.8
  onStarted:
    m_PersistentCalls:
      m_Calls: []
  onFinished:
    m_PersistentCalls:
      m_Calls: []
